# აპის ძირითადი კონფიგურაცია
NODE_ENV=development
PORT=3000

# MongoDB — მონაცემთა ბაზა
# მაგალითი ლოკალური Docker-ისთვის:
# mongodb://<user>:<pass>@<host>:<port>/<db>?authSource=admin
MONGODB_URI=mongodb://admin:password@localhost:27017/chat-app?authSource=admin

# Redis — cache/pub-sub
REDIS_URI=redis://localhost:6379

# RabbitMQ — მესიჯ ქიუ
RABBITMQ_URI=amqp://admin:password@localhost:5672
RABBITMQ_QUEUE=chat_messages

# ავტენტიკაცია / უსაფრთხოება
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d

# შენიშვნა:
# გადააკოპირეთ ეს ფაილი .env სახელით სამუშაო გარემოში და საჭირო ველების მნიშვნელობები შეცვალეთ.

